# GŁÓWNY SILNIK
# ---------------------------------------------------------------------------

class KaiCascadeBoard:
    """
    Dynamiczny silnik propagacji decyzji.

    Nie wybiera "dobrego" scenariusza.
    Porównuje:
    - zasięg skutków,
    - koszt ruchu,
    - zmianę struktury,
    - niepewność,
    - podatność otoczenia,
    - liczbę dotkniętych figur i plansz.
    """

    def __init__(
        self,
        seed: Optional[int] = None,
        cascade_decay: float = 0.65,
        max_depth: int = 4,
        min_effect: float = 0.005,
    ) -> None:
        self.boards: Dict[str, Board] = {}
        self.environments: Dict[str, EnvironmentFactor] = {}
        self.history: List[MoveResult] = []
        self.simulation_time: float = 0.0

        self.rng = random.Random(seed)
        self.seed = seed
        self.cascade_decay = clamp(cascade_decay)
        self.max_depth = max(1, int(max_depth))
        self.min_effect = max(0.0, float(min_effect))

        self._event_sequence = 0

        self.relation_types: Dict[str, Dict[str, float]] = {
            RelationType.DEPENDENCY.value: {
                "propagation_factor": 1.15,
                "risk_factor": 1.15,
                "energy_factor": -0.45,
            },
            RelationType.TRUST.value: {
                "propagation_factor": 0.85,
                "risk_factor": -0.25,
                "energy_factor": 0.35,
            },
            RelationType.CONFLICT.value: {
                "propagation_factor": 1.40,
                "risk_factor": 0.90,
                "energy_factor": -0.65,
            },
            RelationType.FLOW.value: {
                "propagation_factor": 1.00,
                "risk_factor": 0.10,
                "energy_factor": 0.10,
            },
            RelationType.SUPPORT.value: {
                "propagation_factor": 0.75,
                "risk_factor": -0.45,
                "energy_factor": 0.50,
            },
            RelationType.CONTROL.value: {
                "propagation_factor": 1.25,
                "risk_factor": 0.65,
                "energy_factor": -0.35,
            },
            RelationType.INFORMATION.value: {
                "propagation_factor": 0.90,
                "risk_factor": 0.10,
                "energy_factor": 0.05,
            },
            RelationType.CARE.value: {
                "propagation_factor": 0.80,
                "risk_factor": -0.35,
                "energy_factor": 0.45,
            },
            RelationType.COMPETITION.value: {
                "propagation_factor": 1.10,
                "risk_factor": 0.40,
                "energy_factor": -0.15,
            },
        }

    # ------------------------------------------------------------------
    # ZARZĄDZANIE OBIEKTAMI
    # ------------------------------------------------------------------

    def add_board(self, board: Board) -> None:
        if board.id in self.boards:
            raise ValueError(f"Plansza '{board.id}' już istnieje.")
        self.boards[board.id] = board

    def get_board(self, board_id: str) -> Board:
        try:
            return self.boards[board_id]
        except KeyError as exc:
            raise KeyError(f"Nie znaleziono planszy '{board_id}'.") from exc

    def add_environment(self, factor: EnvironmentFactor) -> None:
        self.environments[factor.id] = factor
        for board_id in factor.boards:
            if board_id in self.boards:
                self.boards[board_id].environment_ids.add(factor.id)

    def attach_environment(self, board_id: str, environment_id: str) -> None:
        board = self.get_board(board_id)
        if environment_id not in self.environments:
            raise KeyError(f"Nie znaleziono czynnika '{environment_id}'.")
        board.environment_ids.add(environment_id)

    def add_figure_to_board(
        self,
        board_id: str,
        figure: Figure,
        membership_weight: float = 1.0,
        share_reference: bool = True,
    ) -> None:
        board = self.get_board(board_id)

        if share_reference:
            # Jeśli figura istnieje na innej planszy, używamy tej samej instancji:
            # zmiana w jednym wymiarze może wpłynąć na inne plansze.
            for other_board in self.boards.values():
                if figure.id in other_board.figures:
                    figure = other_board.figures[figure.id]
                    break

        board.figures[figure.id] = figure
        figure.board_membership[board_id] = clamp(membership_weight)
        figure.snapshot(board_id, "figure_added", self.simulation_time)

    def add_relation(
        self,
        board_id: str,
        source_id: str,
        target_id: str,
        relation_type: str = RelationType.DEPENDENCY.value,
        strength: float = 0.5,
        confidence: float = 1.0,
        delay: float = 0.0,
        polarity: float = 1.0,
        permeability: float = 1.0,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> None:
        board = self.get_board(board_id)
        if source_id not in board.figures or target_id not in board.figures:
            raise KeyError("Źródło i cel relacji muszą istnieć na planszy.")

        if relation_type not in self.relation_types:
            raise ValueError(f"Nieznany typ relacji: {relation_type}")

        board.relations[source_id][target_id] = Relation(
            source_id=source_id,
            target_id=target_id,
            type=relation_type,
            strength=strength,
            confidence=confidence,
            delay=delay,
            polarity=polarity,
            permeability=permeability,
            metadata=metadata or {},
        )

    # ------------------------------------------------------------------
    # ŚRODOWISKO / EPIGENETYKA
    # ------------------------------------------------------------------

    def active_environment(
        self,
        board_id: str,
        simulation_time: Optional[float] = None,
    ) -> List[Tuple[EnvironmentFactor, float]]:
        board = self.get_board(board_id)
        current_time = self.simulation_time if simulation_time is None else simulation_time

        factor_ids = set(board.environment_ids)
        factor_ids.update(
            env_id
            for env_id, env in self.environments.items()
            if not env.boards or board_id in env.boards
        )

        active: List[Tuple[EnvironmentFactor, float]] = []
        for env_id in factor_ids:
            env = self.environments.get(env_id)
            if env and env.is_active(current_time, board_id):
                active.append((env, env.effective_intensity(self.rng)))
        return active

    def environment_state_modifier(
        self,
        board_id: str,
        state_key: str,
    ) -> float:
        return sum(
            intensity * env.state_modifiers.get(state_key, 0.0)
            for env, intensity in self.active_environment(board_id)
        )

    def environment_relation_modifier(
        self,
        board_id: str,
        relation_type: str,
    ) -> float:
        raw = 1.0 + sum(
            intensity * env.relation_modifiers.get(relation_type, 0.0)
            for env, intensity in self.active_environment(board_id)
        )
        return max(0.0, raw)

    def environment_action_cost_modifier(
        self,
        board_id: str,
        action_profile: ActionProfile,
    ) -> float:
        multiplier = 1.0
        for env, intensity in self.active_environment(board_id):
            for tag in action_profile.tags:
                multiplier *= max(
                    0.05,
                    1.0 + intensity * env.action_cost_modifiers.get(tag, 0.0),
                )
        return multiplier

    # ------------------------------------------------------------------
    # KOSZT RUCHU
    # ------------------------------------------------------------------

    def calculate_move_cost(
        self,
        figure_id: str,
        board_id: str,
        action_profile: ActionProfile,
    ) -> float:
        board = self.get_board(board_id)
        if figure_id not in board.figures:
            raise KeyError(f"Figura '{figure_id}' nie istnieje na planszy '{board_id}'.")

        figure = board.figures[figure_id]

        cost = figure.move_cost * action_profile.cost_multiplier

        # Stan wewnętrzny
        cost *= 1.0 + figure.risk * 0.45
        cost *= 1.0 + figure.cognitive_load * 0.35
        cost *= 1.0 + (1.0 - figure.resources) * 0.55
        cost *= 1.0 + (1.0 - figure.energy) * 0.35
        cost *= 1.0 - figure.resilience * 0.15
        cost *= 1.0 - figure.exit_capacity * 0.10

        # Kontekst planszy
        cost *= 1.0 + board.inertia * 0.45
        cost *= self.environment_action_cost_modifier(board_id, action_profile)

        return round(max(0.0, cost), 6)

    # ------------------------------------------------------------------
    # RUCH I PROPAGACJA
    # ------------------------------------------------------------------

    def move(
        self,
        figure_id: str,
        board_id: str,
        action: str,
        intensity: float = 1.0,
        action_profile: Optional[ActionProfile] = None,
        propagate: bool = True,
    ) -> MoveResult:
        intensity = clamp(float(intensity))
        board = self.get_board(board_id)

        if figure_id not in board.figures:
            raise KeyError(f"Figura '{figure_id}' nie istnieje na planszy '{board_id}'.")

        profile = action_profile or self._infer_action_profile(action)
        source = board.figures[figure_id]
        timestamp = self.simulation_time

        direct_events: List[CascadeEvent] = []
        cascade_events: List[CascadeEvent] = []
        environment_events: List[CascadeEvent] = []
        cross_board_events: List[CascadeEvent] = []
        warnings: List[str] = []

        source.snapshot(
            board_id,
            f"before_move:{action}",
            timestamp,
            {"profile": profile.name},
        )

        move_cost = self.calculate_move_cost(figure_id, board_id, profile)

        # 1. Skutki bezpośrednie
        for state_key, base_delta in profile.source_deltas.items():
            requested = base_delta * intensity

            # Koszt ruchu najmocniej obciąża energię i zasoby
            if state_key == "energy":
                requested -= 0.08 * move_cost * intensity
            elif state_key == "resources":
                requested -= 0.04 * move_cost * intensity

            event = self._apply_event(
                source_id=figure_id,
                target_id=figure_id,
                board_id=board_id,
                state_key=state_key,
                requested_delta=requested,
                confidence=source.observation_confidence * (1.0 - profile.uncertainty),
                delay=0.0,
                event_kind=EventKind.DIRECT.value,
                depth=0,
                explanation=f"{source.name}: {action}",
                path=(figure_id,),
            )
            direct_events.append(event)

        # Jeżeli profil nie określił energii, koszt nadal istnieje
        if "energy" not in profile.source_deltas:
            direct_events.append(
                self._apply_event(
                    source_id=figure_id,
                    target_id=figure_id,
                    board_id=board_id,
                    state_key="energy",
                    requested_delta=-0.08 * move_cost * intensity,
                    confidence=source.observation_confidence * (1.0 - profile.uncertainty),
                    delay=0.0,
                    event_kind=EventKind.DIRECT.value,
                    depth=0,
                    explanation=f"Koszt wykonania ruchu: {action}",
                    path=(figure_id,),
                )
            )

        # 2. Bezpośrednia modulacja środowiskowa stanu źródła
        for state_key in STATE_KEYS:
            env_delta = self.environment_state_modifier(board_id, state_key)
            if abs(env_delta) < self.min_effect:
                continue
            requested = env_delta * intensity * 0.10
            environment_events.append(
                self._apply_event(
                    source_id="ENVIRONMENT",
                    target_id=figure_id,
                    board_id=board_id,
                    state_key=state_key,
                    requested_delta=requested,
                    confidence=safe_mean(
                        env.confidence for env, _ in self.active_environment(board_id)
                    ),
                    delay=0.0,
                    event_kind=EventKind.ENVIRONMENT.value,
                    depth=0,
                    explanation=f"Otoczenie moduluje {state_key} figury {source.name}",
                    path=("ENVIRONMENT", figure_id),
                )
            )

        # 3. Kaskada na planszy
        if propagate:
            cascade_events.extend(
                self._propagate_from(
                    board_id=board_id,
                    root_source_id=figure_id,
                    profile=profile,
                    intensity=intensity,
                )
            )

        # 4. Przeciek między planszami
        cross_board_events.extend(
            self._cross_board_spillover(
                figure_id=figure_id,
                origin_board_id=board_id,
                profile=profile,
                intensity=intensity,
            )
        )

        source.snapshot(
            board_id,
            f"after_move:{action}",
            self.simulation_time,
            {"move_cost": move_cost},
        )

        all_events = direct_events + cascade_events + environment_events + cross_board_events
        affected_figures = {event.target_id for event in all_events}
        affected_figures.discard("ENVIRONMENT")

        total_impact = sum(
            abs(event.applied_delta) * event.confidence for event in all_events
        )
        uncertainty_score = self._calculate_uncertainty(all_events, profile)
        structural_change_score = self._calculate_structural_change_score(
            board=board,
            move_cost=move_cost,
            all_events=all_events,
            affected_figures=affected_figures,
        )

        if uncertainty_score > 0.6:
            warnings.append("Wysoka niepewność: wynik wymaga dodatkowych danych.")
        if move_cost > max(1.0, source.resources * 3.0):
            warnings.append("Koszt ruchu jest wysoki względem zasobów figury.")
        if len(affected_figures) > max(3, len(board.figures) * 0.6):
            warnings.append("Ruch ma szeroki zasięg kaskadowy.")

        source.learn_from_outcome(total_impact, profile.name)

        result = MoveResult(
            source_id=figure_id,
            action=action,
            board_id=board_id,
            move_cost=move_cost,
            direct_events=direct_events,
            cascade_events=cascade_events,
            environment_events=environment_events,
            cross_board_events=cross_board_events,
            total_impact=round(total_impact, 6),
            structural_change_score=round(structural_change_score, 6),
            uncertainty_score=round(uncertainty_score, 6),
            affected_figures=affected_figures,
            final_state=source.state(),
            timestamp=timestamp,
            warnings=warnings,
        )
        self.history.append(result)
        return result

    def _apply_event(
        self,
        source_id: str,
        target_id: str,
        board_id: str,
        state_key: str,
        requested_delta: float,
        confidence: float,
        delay: float,
        event_kind: str,
        depth: int,
        explanation: str,
        path: Tuple[str, ...],
    ) -> CascadeEvent:
        board = self.get_board(board_id)
        if target_id not in board.figures:
            raise KeyError(f"Brak figury docelowej '{target_id}' na planszy '{board_id}'.")

        target = board.figures[target_id]
        applied_delta = target.apply_delta(state_key, requested_delta)
        target.snapshot(
            board_id,
            explanation,
            self.simulation_time + delay,
            {
                "source_id": source_id,
                "requested_delta": requested_delta,
                "applied_delta": applied_delta,
                "confidence": confidence,
            },
        )

        return CascadeEvent(
            source_id=source_id,
            target_id=target_id,
            board_id=board_id,
            change_type=state_key,
            requested_delta=requested_delta,
            applied_delta=applied_delta,
            confidence=clamp(confidence),
            delay=max(0.0, delay),
            event_kind=event_kind,
            depth=depth,
            explanation=explanation,
            timestamp=self.simulation_time + delay,
            path=path,
        )

    def _propagate_from(
        self,
        board_id: str,
        root_source_id: str,
        profile: ActionProfile,
        intensity: float,
    ) -> List[CascadeEvent]:
        board = self.get_board(board_id)
        events: List[CascadeEvent] = []
        queue: List[ScheduledEffect] = []

        for target_id, relation in board.relations.get(root_source_id, {}).items():
            self._event_sequence += 1
            for state_key, base_delta in profile.propagated_deltas.items():
                effect = self._build_scheduled_effect(
                    board=board,
                    relation=relation,
                    root_source_id=root_source_id,
                    current_source_id=root_source_id,
                    target_id=target_id,
                    state_key=state_key,
                    base_delta=base_delta,
                    intensity=intensity,
                    profile=profile,
                    depth=1,
                    due_time=self.simulation_time + relation.delay,
                    path=(root_source_id, target_id),
                )
                if effect is not None:
                    heapq.heappush(queue, effect)

        while queue:
            scheduled = heapq.heappop(queue)

            if scheduled.depth > self.max_depth:
                continue
            if abs(scheduled.delta) < self.min_effect:
                continue

            self.simulation_time = max(self.simulation_time, scheduled.due_time)

            event = self._apply_event(
                source_id=scheduled.source_id,
                target_id=scheduled.target_id,
                board_id=scheduled.board_id,
                state_key=scheduled.change_type,
                requested_delta=scheduled.delta,
                confidence=scheduled.confidence,
                delay=max(0.0, scheduled.due_time),
                event_kind=scheduled.event_kind,
                depth=scheduled.depth,
                explanation=scheduled.explanation,
                path=scheduled.path,
            )
            events.append(event)

            if scheduled.depth >= self.max_depth:
                continue

            # propagacja wtórna
            for next_target_id, next_relation in board.relations.get(
                scheduled.target_id, {}
            ).items():
                if next_target_id in scheduled.path:
                    continue

                self._event_sequence += 1
                secondary = self._build_scheduled_effect(
                    board=board,
                    relation=next_relation,
                    root_source_id=root_source_id,
                    current_source_id=scheduled.target_id,
                    target_id=next_target_id,
                    state_key=scheduled.change_type,
                    base_delta=scheduled.delta * self.cascade_decay,
                    intensity=1.0,
                    profile=profile,
                    depth=scheduled.depth + 1,
                    due_time=scheduled.due_time + next_relation.delay,
                    path=scheduled.path + (next_target_id,),
                )
                if secondary is not None:
                    heapq.heappush(queue, secondary)

        return events

    def _build_scheduled_effect(
        self,
        board: Board,
        relation: Relation,
        root_source_id: str,
        current_source_id: str,
        target_id: str,
        state_key: str,
        base_delta: float,
        intensity: float,
        profile: ActionProfile,
        depth: int,
        due_time: float,
        path: Tuple[str, ...],
    ) -> Optional[ScheduledEffect]:
        if not relation.active or target_id not in board.figures:
            return None

        target = board.figures[target_id]
        relation_profile = self.relation_types[relation.type]

        relation_factor = relation_profile["propagation_factor"]
        environment_factor = self.environment_relation_modifier(board.id, relation.type)
        board_factor = board.permeability * (1.0 - board.inertia)
        resilience_factor = 1.0 - target.resilience * 0.55
        confidence = (
            relation.confidence
            * target.observation_confidence
            * (1.0 - profile.uncertainty)
        )

        sign_factor = relation.polarity

        # Typ relacji zmienia znak/siłę dla energii i ryzyka
        semantic_factor = 1.0
        if state_key == "energy":
            semantic_factor = relation_profile["energy_factor"]
        elif state_key == "risk":
            semantic_factor = relation_profile["risk_factor"]

        stochasticity = self.rng.uniform(
            1.0 - profile.uncertainty,
            1.0 + profile.uncertainty,
        )

        delta = (
            base_delta
            * intensity
            * relation.strength
            * relation.permeability
            * relation_factor
            * environment_factor
            * board_factor
            * resilience_factor
            * sign_factor
            * semantic_factor
            * stochasticity
            * (self.cascade_decay ** max(0, depth - 1))
        )

        if abs(delta) < self.min_effect:
            return None

        return ScheduledEffect(
            due_time=due_time,
            sequence=self._event_sequence,
            source_id=current_source_id,
            target_id=target_id,
            board_id=board.id,
            change_type=state_key,
            delta=delta,
            confidence=clamp(confidence),
            event_kind=EventKind.CASCADE.value,
            depth=depth,
            explanation=(
                f"Fala od {root_source_id}: {current_source_id} → {target_id}, "
                f"relacja={relation.type}, głębokość={depth}"
            ),
            path=path,
        )

    def _cross_board_spillover(
        self,
        figure_id: str,
        origin_board_id: str,
        profile: ActionProfile,
        intensity: float,
    ) -> List[CascadeEvent]:
        events: List[CascadeEvent] = []
        origin_board = self.get_board(origin_board_id)
        source = origin_board.figures[figure_id]

        for board_id, membership in source.board_membership.items():
            if board_id == origin_board_id or board_id not in self.boards:
                continue

            board = self.boards[board_id]
            if figure_id not in board.figures:
                continue

            for state_key, base_delta in profile.source_deltas.items():
                spill_delta = (
                    base_delta
                    * intensity
                    * profile.board_spillover
                    * membership
                    * board.permeability
                    * (1.0 - board.inertia)
                )
                if abs(spill_delta) < self.min_effect:
                    continue

                events.append(
                    self._apply_event(
                        source_id=figure_id,
                        target_id=figure_id,
                        board_id=board_id,
                        state_key=state_key,
                        requested_delta=spill_delta,
                        confidence=source.observation_confidence
                        * (1.0 - profile.uncertainty),
                        delay=0.0,
                        event_kind=EventKind.CROSS_BOARD.value,
                        depth=0,
                        explanation=(
                            f"Przeciek ruchu '{profile.name}' z planszy "
                            f"{origin_board_id} na {board_id}"
                        ),
                        path=(origin_board_id, board_id, figure_id),
                    )
                )
        return events

    # ------------------------------------------------------------------
    # METRYKI
    # ------------------------------------------------------------------

    def _calculate_structural_change_score(
        self,
        board: Board,
        move_cost: float,
        all_events: Sequence[CascadeEvent],
        affected_figures: Set[str],
    ) -> float:
        """
        Metryka E²=CM² jako poziom emergencji / zmiany strukturalnej,
        a nie "dobroć ruchu".

        E = ważony impakt zdarzeń
        C = złożoność grafu + różnorodność relacji + entropia
        M = masa systemu: zasoby, wpływ, odporność, liczba figur
        """
        impact_energy = sum(
            abs(e.applied_delta) * e.confidence * (1.0 + e.depth * 0.15)
            for e in all_events
        )

        relation_list = [
            relation
            for targets in board.relations.values()
            for relation in targets.values()
        ]
        relation_types = {relation.type for relation in relation_list}
        edge_strength_entropy = shannon_entropy(
            [relation.strength for relation in relation_list]
        )

        density = 0.0
        n = len(board.figures)
        if n > 1:
            density = board.edge_count() / (n * (n - 1))

        complexity = (
            0.30 * clamp(density)
            + 0.25 * clamp(len(relation_types) / max(1, len(RelationType)))
            + 0.25 * edge_strength_entropy
            + 0.20 * clamp(len(affected_figures) / max(1, n))
        )

        system_mass = 0.0
        for figure in board.figures.values():
            system_mass += safe_mean(
                [
                    figure.resources,
                    figure.influence,
                    figure.resilience,
                    figure.energy,
                ]
            )
        system_mass = max(0.1, system_mass / max(1, n))

        # Znormalizowana postać inspirowana E² = C M²:
        numerator = impact_energy ** 2
        denominator = max(0.05, complexity * system_mass ** 2 + move_cost * 0.10)
        raw = numerator / denominator

        return clamp(1.0 - math.exp(-raw))

    def _calculate_uncertainty(
        self,
        events: Sequence[CascadeEvent],
        profile: ActionProfile,
    ) -> float:
        if not events:
            return profile.uncertainty
        confidence_deficit = safe_mean(1.0 - event.confidence for event in events)
        depth_penalty = clamp(
            safe_mean(event.depth for event in events) / max(1, self.max_depth)
        )
        return clamp(
            0.50 * profile.uncertainty
            + 0.35 * confidence_deficit
            + 0.15 * depth_penalty
        )

    # ------------------------------------------------------------------
    # SCENARIUSZE
    # ------------------------------------------------------------------

    def clone(self) -> "KaiCascadeBoard":
        return copy.deepcopy(self)

    def simulate_scenario(
        self,
        name: str,
        moves: Sequence[
            Tuple[str, str, str, float, Optional[ActionProfile]]
        ],
        isolated: bool = True,
    ) -> ScenarioResult:
        """
        Symulacja scenariusza.

        Każdy ruch:
            (figure_id, board_id, action, intensity, optional_action_profile)

        isolated=True:
            scenariusz nie zmienia oryginalnego silnika i może być uczciwie
            porównany z innym scenariuszem od tego samego stanu początkowego.
        """
        engine = self.clone() if isolated else self

        move_results: List[MoveResult] = []
        all_events: List[CascadeEvent] = []
        affected: Set[str] = set()

        for figure_id, board_id, action, intensity, profile in moves:
            result = engine.move(
                figure_id=figure_id,
                board_id=board_id,
                action=action,
                intensity=intensity,
                action_profile=profile,
            )
            move_results.append(result)
            all_events.extend(
                result.direct_events
                + result.cascade_events
                + result.environment_events
                + result.cross_board_events
            )
            affected.update(result.affected_figures)

        total_impact = sum(result.total_impact for result in move_results)
        structural_score = safe_mean(
            result.structural_change_score for result in move_results
        )
        uncertainty_score = safe_mean(
            result.uncertainty_score for result in move_results
        )

        final_snapshot = engine.snapshot_system()

        summary = (
            f"Scenariusz '{name}': {len(move_results)} ruchów, "
            f"{len(all_events)} zdarzeń, {len(affected)} figur dotkniętych. "
            f"Impakt={total_impact:.3f}, "
            f"zmiana strukturalna={structural_score:.3f}, "
            f"niepewność={uncertainty_score:.3f}."
        )

        return ScenarioResult(
            name=name,
            moves=move_results,
            all_events=all_events,
            total_impact=round(total_impact, 6),
            structural_change_score=round(structural_score, 6),
            uncertainty_score=round(uncertainty_score, 6),
            affected_figures=affected,
            final_snapshot=final_snapshot,
            summary=summary,
        )

    def compare_scenarios(
        self,
        scenarios: Sequence[ScenarioResult],
        weights: Optional[Mapping[str, float]] = None,
    ) -> Dict[str, Any]:
        """
        Porównuje scenariusze bez nazywania ich dobrymi/złymi.

        Domyślna metryka opisuje:
        - mniejszy impakt,
        - mniejszą niepewność,
        - mniejszą zmianę strukturalną.

        Użytkownik może zmienić wagi zgodnie z celem analizy.
        """
        if not scenarios:
            raise ValueError("Brak scenariuszy do porównania.")

        weights = dict(
            weights
            or {
                "impact": 0.35,
                "uncertainty": 0.30,
                "structural_change": 0.25,
                "reach": 0.10,
            }
        )

        max_impact = max(s.total_impact for s in scenarios) or 1.0
        max_reach = max(len(s.affected_figures) for s in scenarios) or 1

        rows: List[Dict[str, Any]] = []
        for scenario in scenarios:
            normalized_impact = scenario.total_impact / max_impact
            normalized_reach = len(scenario.affected_figures) / max_reach

            burden_score = (
                weights.get("impact", 0.0) * normalized_impact
                + weights.get("uncertainty", 0.0) * scenario.uncertainty_score
                + weights.get("structural_change", 0.0)
                * scenario.structural_change_score
                + weights.get("reach", 0.0) * normalized_reach
            )

            rows.append(
                {
                    "name": scenario.name,
                    "total_impact": scenario.total_impact,
                    "structural_change_score": scenario.structural_change_score,
                    "uncertainty_score": scenario.uncertainty_score,
                    "affected_figures": len(scenario.affected_figures),
                    "burden_score": round(burden_score, 6),
                }
            )

        rows.sort(key=lambda row: row["burden_score"])

        return {
            "interpretation": (
                "Niższy burden_score oznacza mniejsze obciążenie systemu "
                "przy aktualnych wagach. Nie oznacza moralnie lepszego wyboru."
            ),
            "weights": weights,
            "ranking": rows,
            "lowest_burden_scenario": rows[0]["name"],
        }

    # ------------------------------------------------------------------
    # MONTE CARLO
    # ------------------------------------------------------------------

    def monte_carlo(
        self,
        name: str,
        moves: Sequence[
            Tuple[str, str, str, float, Optional[ActionProfile]]
        ],
        runs: int = 100,
    ) -> Dict[str, Any]:
        if runs < 1:
            raise ValueError("runs musi być >= 1")

        impacts: List[float] = []
        structural: List[float] = []
        uncertainty: List[float] = []

        for run_index in range(runs):
            engine = self.clone()
            engine.rng.seed((self.seed or 0) + run_index + 1)
            scenario = engine.simulate_scenario(
                name=name,
                moves=moves,
                isolated=False,
            )
            impacts.append(scenario.total_impact)
            structural.append(scenario.structural_change_score)
            uncertainty.append(scenario.uncertainty_score)

        def quantile(values: List[float], q: float) -> float:
            sorted_values = sorted(values)
            index = int(round((len(sorted_values) - 1) * q))
            return sorted_values[index]

        return {
            "name": name,
            "runs": runs,
            "impact": {
                "mean": safe_mean(impacts),
                "p10": quantile(impacts, 0.10),
                "median": quantile(impacts, 0.50),
                "p90": quantile(impacts, 0.90),
            },
            "structural_change": {
                "mean": safe_mean(structural),
                "p10": quantile(structural, 0.10),
                "median": quantile(structural, 0.50),
                "p90": quantile(structural, 0.90),
            },
            "uncertainty": {
                "mean": safe_mean(uncertainty),
                "p10": quantile(uncertainty, 0.10),
                "median": quantile(uncertainty, 0.50),
                "p90": quantile(uncertainty, 0.90),
            },
        }

    # ------------------------------------------------------------------
    # PROFILE RUCHÓW
    # ------------------------------------------------------------------

    def _infer_action_profile(self, action: str) -> ActionProfile:
        """
        Warstwa kompatybilności dla prostego użycia tekstowego.
        W analizach produkcyjnych lepiej przekazać ActionProfile jawnie.
        """
        text = action.lower()

        if "przeprowadz" in text or "move" in text:
            return ActionProfile(
                name="relocation",
                source_deltas={
                    "energy": -0.12,
                    "resources": -0.10,
                    "risk": 0.12,
                    "cognitive_load": 0.18,
                },
                propagated_deltas={
                    "energy": 0.20,
                    "risk": 0.25,
                    "resources": -0.10,
                },
                cost_multiplier=2.0,
                tags={"relocation", "logistics", "life_change"},
                board_spillover=0.60,
                uncertainty=0.20,
            )

        if "rozmow" in text or "conversation" in text:
            return ActionProfile(
                name="conversation",
                source_deltas={
                    "energy": -0.02,
                    "cognitive_load": -0.03,
                    "trust_capacity": 0.04,
                },
                propagated_deltas={
                    "energy": 0.08,
                    "risk": -0.06,
                    "trust_capacity": 0.10,
                },
                cost_multiplier=0.45,
                tags={"communication"},
                board_spillover=0.15,
                uncertainty=0.12,
            )

        if "wdroż" in text or "deploy" in text or "launch" in text:
            return ActionProfile(
                name="deployment",
                source_deltas={
                    "energy": -0.10,
                    "resources": -0.12,
                    "risk": 0.10,
                    "influence": 0.08,
                    "cognitive_load": 0.12,
                },
                propagated_deltas={
                    "risk": 0.18,
                    "energy": 0.08,
                    "influence": 0.12,
                },
                cost_multiplier=1.6,
                tags={"deployment", "technology", "compliance"},
                board_spillover=0.50,
                uncertainty=0.18,
            )

        return ActionProfile(
            name="generic_action",
            source_deltas={
                "energy": -0.04,
                "risk": 0.03,
                "cognitive_load": 0.02,
            },
            propagated_deltas={
                "energy": 0.08,
                "risk": 0.08,
            },
            cost_multiplier=1.0,
            tags={"generic"},
            board_spillover=0.25,
            uncertainty=0.15,
        )

    # ------------------------------------------------------------------
    # EKSPORT I SNAPSHOT
    # ------------------------------------------------------------------

    def snapshot_system(self) -> Dict[str, Any]:
        return {
            "simulation_time": self.simulation_time,
            "boards": {
                board_id: {
                    "name": board.name,
                    "figures": {
                        figure_id: figure.state()
                        for figure_id, figure in board.figures.items()
                    },
                    "relations_count": board.edge_count(),
                    "environment_ids": sorted(board.environment_ids),
                }
                for board_id, board in self.boards.items()
            },
        }

    def export_move_json(self, result: MoveResult) -> str:
        return json.dumps(
            self._serialize(result),
            indent=2,
            ensure_ascii=False,
        )

    def export_scenario_json(self, result: ScenarioResult) -> str:
        return json.dumps(
            self._serialize(result),
            indent=2,
            ensure_ascii=False,
        )

    def export_engine_json(self) -> str:
        payload = {
            "simulation_time": self.simulation_time,
            "seed": self.seed,
            "cascade_decay": self.cascade_decay,
            "max_depth": self.max_depth,
            "boards": self._serialize(self.boards),
            "environments": self._serialize(self.environments),
            "history": self._serialize(self.history),
        }
        return json.dumps(payload, indent=2, ensure_ascii=False)

    def _serialize(self, value: Any) -> Any:
        if isinstance(value, Enum):
            return value.value
        if hasattr(value, "__dataclass_fields__"):
            return {
                key: self._serialize(item)
                for key, item in asdict(value).items()
            }
        if isinstance(value, dict):
            return {
                str(key): self._serialize(item)
                for key, item in value.items()
            }
        if isinstance(value, (list, tuple, deque, set)):
            return [self._serialize(item) for item in value]
        return value


