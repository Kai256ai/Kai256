@dataclass
class StateSnapshot:
    timestamp: float
    board_id: str
    reason: str
    state: Dict[str, float]
    metadata: Dict[str, Any] = field(default_factory=dict)


@dataclass
class Figure:
    """
    Figura może reprezentować człowieka, organizację, model AI, dokument,
    pieniądz, decyzję, emocję lub inny aktywny element systemu.
    """
    id: str
    name: str
    type: str = NodeType.HUMAN.value

    energy: float = 0.8
    resources: float = 0.7
    risk: float = 0.2
    influence: float = 0.5
    resilience: float = 0.5
    trust_capacity: float = 0.5
    cognitive_load: float = 0.2

    move_cost: float = 1.0
    exit_capacity: float = 0.5
    learning_rate: float = 0.1
    observation_confidence: float = 1.0

    goals: List[str] = field(default_factory=list)
    constraints: List[str] = field(default_factory=list)
    tags: Set[str] = field(default_factory=set)

    # board_id -> membership weight 0..1
    board_membership: Dict[str, float] = field(default_factory=dict)

    history: Deque[StateSnapshot] = field(default_factory=lambda: deque(maxlen=250))
    memory: Dict[str, float] = field(default_factory=dict)

    def __post_init__(self) -> None:
        for key in STATE_KEYS:
            setattr(self, key, clamp(float(getattr(self, key))))
        self.exit_capacity = clamp(float(self.exit_capacity))
        self.learning_rate = clamp(float(self.learning_rate))
        self.observation_confidence = clamp(float(self.observation_confidence))
        self.move_cost = max(0.0, float(self.move_cost))

        if not self.goals:
            self.goals = ["przetrwanie", "rozwój"]
        if not self.constraints:
            self.constraints = ["ograniczone zasoby"]

    def state(self) -> Dict[str, float]:
        return {key: float(getattr(self, key)) for key in STATE_KEYS}

    def snapshot(
        self,
        board_id: str,
        reason: str,
        timestamp: Optional[float] = None,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> None:
        self.history.append(
            StateSnapshot(
                timestamp=time.time() if timestamp is None else timestamp,
                board_id=board_id,
                reason=reason,
                state=self.state(),
                metadata=metadata or {},
            )
        )

    def apply_delta(self, key: str, delta: float) -> float:
        if key not in BOUNDED_STATE_KEYS:
            raise ValueError(f"Nieobsługiwany parametr stanu: {key}")
        old_value = float(getattr(self, key))
        new_value = clamp(old_value + delta)
        setattr(self, key, new_value)
        return new_value - old_value

    def learn_from_outcome(self, signal: float, label: str) -> None:
        """
        Prosta pamięć adaptacyjna. Nie interpretuje moralnie wyniku.
        Zapisuje siłę doświadczenia i stopniowo dostosowuje odporność.
        """
        signal = clamp(abs(signal))
        previous = self.memory.get(label, 0.0)
        self.memory[label] = clamp(
            (1.0 - self.learning_rate) * previous + self.learning_rate * signal
        )
        self.resilience = clamp(
            self.resilience + self.learning_rate * (signal - 0.5) * 0.05
        )


@dataclass
class EnvironmentFactor:
    """
    Pole środowiskowe / epigenetyczne.

    Nie jest "graczem", lecz warunkiem, który moduluje zachowanie figur,
    relacji oraz kosztów. Przykłady: prawo, inflacja, sen, hałas, wojna,
    pogoda, kultura organizacyjna, presja czasu, stabilność domu.
    """
    id: str
    name: str
    category: str
    intensity: float = 0.5
    volatility: float = 0.0
    confidence: float = 1.0

    # parametr stanu -> współczynnik modulacji; np. {"risk": 0.3, "energy": -0.2}
    state_modifiers: Dict[str, float] = field(default_factory=dict)

    # typ relacji -> współczynnik modulacji propagacji
    relation_modifiers: Dict[str, float] = field(default_factory=dict)

    # typ akcji/tag -> współczynnik kosztu
    action_cost_modifiers: Dict[str, float] = field(default_factory=dict)

    # plansze, na których czynnik działa; puste = wszystkie
    boards: Set[str] = field(default_factory=set)

    active_from: float = 0.0
    active_until: Optional[float] = None

    def __post_init__(self) -> None:
        self.intensity = clamp(float(self.intensity))
        self.volatility = clamp(float(self.volatility))
        self.confidence = clamp(float(self.confidence))

    def is_active(self, simulation_time: float, board_id: str) -> bool:
        if self.boards and board_id not in self.boards:
            return False
        if simulation_time < self.active_from:
            return False
        if self.active_until is not None and simulation_time > self.active_until:
            return False
        return True

    def effective_intensity(self, rng: random.Random) -> float:
        jitter = rng.uniform(-self.volatility, self.volatility)
        return clamp(self.intensity + jitter) * self.confidence


@dataclass
class Relation:
    source_id: str
    target_id: str
    type: str = RelationType.DEPENDENCY.value
    strength: float = 0.5
    confidence: float = 1.0
    delay: float = 0.0
    polarity: float = 1.0
    permeability: float = 1.0
    active: bool = True
    metadata: Dict[str, Any] = field(default_factory=dict)

    def __post_init__(self) -> None:
        self.strength = clamp(float(self.strength))
        self.confidence = clamp(float(self.confidence))
        self.delay = max(0.0, float(self.delay))
        self.polarity = clamp(float(self.polarity), -1.0, 1.0)
        self.permeability = clamp(float(self.permeability))


@dataclass
class Board:
    id: str
    name: str
    description: str = ""
    figures: Dict[str, Figure] = field(default_factory=dict)

    # source_id -> target_id -> Relation
    relations: Dict[str, Dict[str, Relation]] = field(
        default_factory=lambda: defaultdict(dict)
    )

    # środowisko lokalne planszy
    environment_ids: Set[str] = field(default_factory=set)

    # opór planszy na zmianę 0..1
    inertia: float = 0.2

    # podatność na rozchodzenie się fal 0..1
    permeability: float = 0.8

    timestamp: float = field(default_factory=time.time)

    def __post_init__(self) -> None:
        self.inertia = clamp(float(self.inertia))
        self.permeability = clamp(float(self.permeability))

    def edge_count(self) -> int:
        return sum(len(targets) for targets in self.relations.values())


