def build_demo_engine() -> KaiCascadeBoard:
    engine = KaiCascadeBoard(seed=1448, max_depth=4)

    family = Board(
        id="family",
        name="Plansza rodzinna",
        description="Relacje, bezpieczeństwo i codzienna stabilność.",
        inertia=0.45,
        permeability=0.75,
    )
    professional = Board(
        id="professional",
        name="Plansza zawodowa",
        description="Projekty, praca, zasoby i wpływ.",
        inertia=0.25,
        permeability=0.85,
    )
    financial = Board(
        id="financial",
        name="Plansza finansowa",
        description="Płynność, zobowiązania i zasoby.",
        inertia=0.55,
        permeability=0.70,
