class CascadeVisualizer:
    """
    Warstwa wizualna.

    Domyślna semantyka:
    - kolor węzła: ryzyko;
    - rozmiar węzła: wpływ;
    - grubość krawędzi: siła relacji;
    - przezroczystość krawędzi: pewność relacji.
    """

    def __init__(self, engine: KaiCascadeBoard) -> None:
        self.engine = engine

    def build_graph(self, board_id: str):
        if not HAS_NX:
            raise RuntimeError("Brak networkx.")
        board = self.engine.get_board(board_id)
        graph = nx.DiGraph()

        for figure in board.figures.values():
            graph.add_node(
                figure.id,
                name=figure.name,
                risk=figure.risk,
                influence=figure.influence,
                energy=figure.energy,
                type=figure.type,
            )

        for targets in board.relations.values():
            for relation in targets.values():
                graph.add_edge(
                    relation.source_id,
                    relation.target_id,
                    weight=relation.strength,
                    confidence=relation.confidence,
                    type=relation.type,
                )
        return graph

    def visualize_static(
        self,
        board_id: str,
        title: str = "KaiCascadeBoard — mapa zależności",
    ) -> None:
        if not HAS_NX or not HAS_MPL:
            raise RuntimeError(
                "Wizualizacja wymaga: pip install networkx matplotlib"
            )

        graph = self.build_graph(board_id)
        if graph.number_of_nodes() == 0:
            raise ValueError("Graf jest pusty.")

        positions = nx.spring_layout(graph, seed=42, k=1.4)

        risks = [graph.nodes[node]["risk"] for node in graph.nodes]
        sizes = [
            1200 + 3200 * graph.nodes[node]["influence"]
            for node in graph.nodes
        ]
        widths = [
            0.5 + 4.0 * data["weight"]
            for _, _, data in graph.edges(data=True)
        ]
        alphas = [
            0.15 + 0.80 * data["confidence"]
            for _, _, data in graph.edges(data=True)
        ]

        plt.figure(figsize=(14, 10))
        nodes = nx.draw_networkx_nodes(
            graph,
            positions,
            node_color=risks,
            cmap=plt.cm.RdYlGn_r,
            node_size=sizes,
            alpha=0.9,
        )
        nodes.set_clim(0.0, 1.0)

        # NetworkX nie przyjmuje osobnego alpha dla każdej krawędzi w każdej wersji,
        # więc rysujemy je osobno.
        for (source, target, data), width, alpha in zip(
            graph.edges(data=True), widths, alphas
        ):
            nx.draw_networkx_edges(
                graph,
                positions,
                edgelist=[(source, target)],
                width=width,
                alpha=alpha,
                arrows=True,
                arrowstyle="-|>",
                arrowsize=14,
            )

        labels = {
            node: graph.nodes[node].get("name", node)
            for node in graph.nodes
        }
        nx.draw_networkx_labels(
            graph,
            positions,
            labels=labels,
            font_size=10,
            font_weight="bold",
        )

        plt.colorbar(nodes, label="Ryzyko")
        plt.title(title, fontsize=17, pad=18)
        plt.axis("off")
        plt.tight_layout()
        plt.show()


