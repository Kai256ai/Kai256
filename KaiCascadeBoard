        )
    )

    return engine


if __name__ == "__main__":
    cascade = build_demo_engine()

    deployment = ActionProfile(
        name="kai_space_release",
        source_deltas={
            "energy": -0.12,
            "resources": -0.10,
            "risk": 0.09,
            "influence": 0.12,
            "cognitive_load": 0.14,
        },
        propagated_deltas={
            "energy": 0.14,
            "risk": 0.16,
            "resources": -0.08,
            "influence": 0.18,
        },
        cost_multiplier=1.65,
        tags={"deployment", "technology", "compliance"},
        board_spillover=0.55,
        uncertainty=0.16,
    )

    result = cascade.move(
        figure_id="ania",
        board_id="professional",
        action="Wdrożenie KaiSpace",
        intensity=0.90,
        action_profile=deployment,
    )

    print("=" * 72)
    print("KAI CASCADE BOARD v3.0")
    print("Nie oceniamy. Analizujemy ruch, falę, koszt i niepewność.")
    print("=" * 72)
    print(f"Ruch: {result.action}")
    print(f"Koszt: {result.move_cost:.3f}")
    print(f"Impakt: {result.total_impact:.3f}")
    print(f"Zmiana strukturalna E²=CM²: {result.structural_change_score:.3f}")
    print(f"Niepewność: {result.uncertainty_score:.3f}")
    print(f"Dotknięte figury: {sorted(result.affected_figures)}")
    if result.warnings:
        print("Uwagi:")
        for warning in result.warnings:
            print(f"  - {warning}")

    print("\nPierwsze zdarzenia:")
    all_events = (
        result.direct_events
        + result.environment_events
        + result.cascade_events
        + result.cross_board_events
    )
    for event in all_events[:10]:
        print(
            f"  [{event.event_kind}] {event.source_id} → {event.target_id}: "
            f"{event.change_type} {event.applied_delta:+.3f} "
            f"(pewność={event.confidence:.2f}, depth={event.depth})"
        )

    scenario_a = cascade.simulate_scenario(
        "Wdrożenie etapowe",
        [
            ("ania", "professional", "Rozmowa z partnerem", 0.5, None),
            ("ania", "professional", "Wdrożenie KaiSpace", 0.65, deployment),
        ],
    )
    scenario_b = cascade.simulate_scenario(
        "Wdrożenie natychmiastowe",
        [
            ("ania", "professional", "Wdrożenie KaiSpace", 1.0, deployment),
        ],
    )

    comparison = cascade.compare_scenarios([scenario_a, scenario_b])
    print("\nPorównanie scenariuszy:")
    print(json.dumps(comparison, indent=2, ensure_ascii=False))
