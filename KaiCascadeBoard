@dataclass
class ActionProfile:
    """
    Opis ruchu niezależny od tekstowego słowa kluczowego.
    Tekst akcji jest narracją, a profil jest właściwym wejściem modelu.
    """
    name: str
    source_deltas: Dict[str, float] = field(default_factory=dict)
    propagated_deltas: Dict[str, float] = field(default_factory=dict)
    cost_multiplier: float = 1.0
    tags: Set[str] = field(default_factory=set)
    board_spillover: float = 0.25
    uncertainty: float = 0.1

    def __post_init__(self) -> None:
        self.cost_multiplier = max(0.0, float(self.cost_multiplier))
        self.board_spillover = clamp(float(self.board_spillover))
        self.uncertainty = clamp(float(self.uncertainty))


