def clamp(value: float, low: float = 0.0, high: float = 1.0) -> float:
    return max(low, min(high, value))


def safe_mean(values: Iterable[float], default: float = 0.0) -> float:
    values = list(values)
    return sum(values) / len(values) if values else default


def shannon_entropy(values: Sequence[float]) -> float:
    """
    Entropia Shannona dla nieujemnych wag.
    Wynik znormalizowany do 0..1.
    """
    cleaned = [max(0.0, float(v)) for v in values]
    total = sum(cleaned)
    if total <= 0 or len(cleaned) <= 1:
        return 0.0

    probabilities = [v / total for v in cleaned if v > 0]
    entropy = -sum(p * math.log(p, 2) for p in probabilities)
    max_entropy = math.log(len(probabilities), 2) if len(probabilities) > 1 else 1.0
    return clamp(entropy / max_entropy)


