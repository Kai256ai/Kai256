# ==================== OPTYMALIZACJA TOKENÓW ====================

class TokenOptimizer:
    """Optymalizator zużycia tokenów dla Lovable"""
    
    @staticmethod
    def compress_content(content: str, max_tokens: int = 100) -> str:
        """Kompresuje treść do limitu tokenów"""
        words = content.split()
        if len(words) <= max_tokens:
            return content
        
        # Zachowaj początek i koniec
        half = max_tokens // 2
        compressed = ' '.join(words[:half] + ['[...]'] + words[-half:])
        return compressed
    
    @staticmethod
    def encode_delta(original: str, new: str) -> Dict:
        """Koduje tylko różnice między wersjami (delta encoding)"""
        if original == new:
            return {'type': 'no_change'}
        
        # Znajdź różnice (uproszczone)
        original_words = original.split()
        new_words = new.split()
        
        # Znajdź dodane/usunięte słowa
        added = [w for w in new_words if w not in original_words]
        removed = [w for w in original_words if w not in new_words]
        
        return {
            'type': 'delta',
            'added': added,
            'removed': removed,
            'original_length': len(original_words),
            'new_length': len(new_words)
        }
    
    @staticmethod
    def apply_delta(original: str, delta: Dict) -> str:
        """Stosuje delta encoding do odtworzenia treści"""
        if delta.get('type') == 'no_change':
            return original
        
        words = original.split()
        
        # Usuń słowa
        for word in delta.get('removed', []):
            if word in words:
                words.remove(word)
        
        # Dodaj słowa
        words.extend(delta.get('added', []))
        
        return ' '.join(words)
    
    @staticmethod
    def optimize_for_api(data: Dict, target_size_kb: float = 10) -> Dict:
        """Optymalizuje dane dla API Lovable"""
        serialized = json.dumps(data)
        size_kb = len(serialized) / 1024
        
        if size_kb <= target_size_kb:
            return data
        
        # Strategie optymalizacji
        optimized = data.copy()
        
        # 1. Usuń puste pola
        optimized = {k: v for k, v in optimized.items() if v not in ([], {}, None, '')}
        
        # 2. Skróć długie teksty
        for key, value in optimized.items():
            if isinstance(value, str) and len(value) > 500:
                optimized[key] = TokenOptimizer.compress_content(value, 100)
        
        # 3. Użyj krótkich kluczy
        if len(optimized) > 20:
            # Skróć klucze dla dużych obiektów
            new_dict = {}
            for i, (key, value) in enumerate(optimized.items()):
                new_dict[f'k{i}'] = value
            optimized = {'_mapping': list(optimized.keys()), '_data': new_dict}
        
        return optimized

# ==================== ENUMS (MINIMALNE) ====================

class NoteType(Enum):
    TEXT = "txt"
    VOICE = "vox"
    SKETCH = "sketch"
    REMINDER = "remind"
    LINK = "link"

class FolderType(Enum):
    MODULES = "mod"
    PROJECTS = "proj"
    PATENTS = "pat"
    LEGAL = "law"
    DAILY = "day"
    EXPERIMENTS = "exp"

class Priority(Enum):
    LOW = 1
    MEDIUM = 2
    HIGH = 3
    URGENT = 4

# ==================== DATACLASSES (OPTYMALNE) ====================

@dataclass
class Note:
    """Minimalna reprezentacja notatki"""
    id: str
    type: NoteType
    content: str
    folder: FolderType
    created: float
    modified: float = None
    tags: List[str] = None
    priority: Priority = Priority.MEDIUM
    metadata: Dict = None
    
    def __post_init__(self):
        if self.modified is None:
            self.modified = self.created
        if self.tags is None:
            self.tags = []
        if self.metadata is None:
            self.metadata = {}
    
    def to_dict(self) -> Dict:
        """Konwertuje do słownika z optymalizacją"""
        return {
            'i': self.id,
            't': self.type.value,
            'c': TokenOptimizer.compress_content(self.content, 50),
            'f': self.folder.value,
            'cr': int(self.created),
            'm': int(self.modified),
            'tg': self.tags[:3],  # Maks 3 tagi
            'p': self.priority.value
        }

@dataclass
class VoiceNote:
    """Optymalna reprezentacja notatki głosowej"""
    id: str
    audio_url: str  # URL do pliku w chmurze
    transcript: str  # Transkrypcja tekstowa
    duration: float  # Czas trwania w sekundach
    emotion: str = None  # Wykryta emocja
    speaker: str = None  # Rozpoznany mówca
    
    def to_dict(self) -> Dict:
        return {
            'i': self.id,
            'u': self.audio_url,
            't': TokenOptimizer.compress_content(self.transcript, 30),
            'd': int(self.duration)
        }

@dataclass
class Reminder:
    """Kontekstowe przypomnienie"""
    id: str
    note_id: str
    trigger_type: str  # time/location/state/context
    trigger_value: str  # konkretny trigger
    message: str
    created: float
    triggered: bool = False
    
    def to_dict(self) -> Dict:
        return {
            'i': self.id,
            'n': self.note_id,
            'tt': self.trigger_type[:3],  # 3-znakowy kod
            'tv': self.trigger_value,
            'm': self.message[:50]
        }

# ==================== KAI MEMORY CACHE ====================

class KaiMemoryCache:
    """Inteligentny cache pamięci dla minimalnych tokenów"""
    
    def __init__(self, max_size_mb: float = 10):
        self.max_size = max_size_mb * 1024 * 1024  # Bajty
        self.cache: Dict[str, Any] = {}
        self.access_times: Dict[str, float] = {}
        self.total_size = 0
        self.hits = 0
        self.misses = 0
    
    def get(self, key: str) -> Optional[Any]:
        """Pobiera z cache'u"""
        if key in self.cache:
            self.access_times[key] = time.time()
            self.hits += 1
            return self.cache[key]
        
        self.misses += 1
        return None
    
    def set(self, key: str, value: Any, size_bytes: int = None):
        """Ustawia w cache'u"""
        if size_bytes is None:
            size_bytes = len(json.dumps(value).encode('utf-8'))
        
        # Jeśli przekraczamy rozmiar, wyczyść najstarsze
        while self.total_size + size_bytes > self.max_size and self.cache:
            oldest_key = min(self.access_times.items(), key=lambda x: x[1])[0]
            self._evict(oldest_key)
        
        self.cache[key] = value
        self.access_times[key] = time.time()
        self.total_size += size_bytes
    
    def _evict(self, key: str):
        """Usuwa klucz z cache'u"""
        if key in self.cache:
            value = self.cache.pop(key)
            size = len(json.dumps(value).encode('utf-8'))
            self.total_size -= size
            self.access_times.pop(key, None)
    
    def get_stats(self) -> Dict:
        """Zwraca statystyki cache'u"""
        return {
            'items': len(self.cache),
            'size_mb': self.total_size / (1024 * 1024),
            'hits': self.hits,
            'misses': self.misses,
            'hit_rate': self.hits / max(self.hits + self.misses, 1)
        }

# ==================== GŁÓWNY SYSTEM KAIBOARD ====================

class KaiBoardLovable:
    """
    Główny system KaiBoard zoptymalizowany dla Lovable
    - Minimalne zużycie tokenów
    - Maksymalna funkcjonalność
    - Szybka odpowiedź
    """
    
    def __init__(self):
        self.notes: Dict[str, Note] = {}
        self.voice_notes: Dict[str, VoiceNote] = {}
        self.reminders: Dict[str, Reminder] = {}
        
        # Foldery
        self.folders: Dict[FolderType, List[str]] = {
            FolderType.MODULES: [],
            FolderType.PROJECTS: [],
            FolderType.PATENTS: [],
            FolderType.LEGAL: [],
            FolderType.DAILY: [],
            FolderType.EXPERIMENTS: []
        }
        
        # Cache dla szybkiego dostępu
        self.cache = KaiMemoryCache(max_size_mb=5)
        
        # Statystyki
        self.stats = {
            'notes_created': 0,
            'voice_notes': 0,
            'reminders_set': 0,
            'api_calls': 0,
            'tokens_saved': 0
        }
    
    # ==================== OPERACJE NA NOTATKACH ====================
    
    def create_note(self, 
                   content: str, 
                   folder: FolderType,
                   note_type: NoteType = NoteType.TEXT,
                   tags: List[str] = None,
                   priority: Priority = Priority.MEDIUM) -> str:
        """Tworzy nową notatkę z optymalizacją"""
        note_id = f"n{int(time.time())}{len(self.notes):04d}"
        
        note = Note(
            id=note_id,
            type=note_type,
            content=content,
            folder=folder,
            created=time.time(),
            tags=tags or [],
            priority=priority,
            metadata={'version': 1}
        )
        
        self.notes[note_id] = note
        self.folders[folder].append(note_id)
        
        # Cache'uj
        cache_key = f"note_{note_id}"
        self.cache.set(cache_key, note.to_dict())
        
        self.stats['notes_created'] += 1
        self.stats['tokens_saved'] += len(content) // 4  # Przybliżenie tokenów
        
        return note_id
    
    def update_note(self, note_id: str, new_content: str) -> bool:
        """Aktualizuje notatkę z delta encoding"""
        if note_id not in self.notes:
            return False
        
        note = self.notes[note_id]
        original = note.content
        
        # Użyj delta encoding
        delta = TokenOptimizer.encode_delta(original, new_content)
        
        if delta['type'] == 'no_change':
            return True
        
        # Aktualizuj
        note.content = new_content
        note.modified = time.time()
        note.metadata['version'] = note.metadata.get('version', 1) + 1
        note.metadata['last_delta'] = delta
        
        # Aktualizuj cache
        cache_key = f"note_{note_id}"
        self.cache.set(cache_key, note.to_dict())
        
        # Zapisz oszczędność tokenów
        original_tokens = len(original.split())
        new_tokens = len(new_content.split())
        self.stats['tokens_saved'] += max(0, original_tokens - new_tokens)
        
        return True
    
    def get_note(self, note_id: str, full: bool = False) -> Optional[Dict]:
        """Pobiera notatkę z cache'u"""
        cache_key = f"note_{note_id}"
        
        # Spróbuj z cache
        cached = self.cache.get(cache_key)
        if cached and not full:
            return cached
        
        # Pobierz pełną notatkę
        if note_id not in self.notes:
            return None
        
        note = self.notes[note_id]
        
        if full:
            result = asdict(note)
        else:
            result = note.to_dict()
        
        # Cache'uj wynik
        self.cache.set(cache_key, result)
        
        return result
    
    # ==================== NOTATKI GŁOSOWE ====================
    
    def add_voice_note(self, 
                      audio_url: str,
                      transcript: str,
                      duration: float,
                      folder: FolderType = FolderType.DAILY) -> str:
        """Dodaje notatkę głosową"""
        voice_id = f"v{int(time.time())}{len(self.voice_notes):04d}"
        
        # Automatyczne tagowanie emocji (uproszczone)
        emotion = self._detect_emotion(transcript)
        
        voice_note = VoiceNote(
            id=voice_id,
            audio_url=audio_url,
            transcript=transcript,
            duration=duration,
            emotion=emotion,
            speaker="Ania"  # W rzeczywistości rozpoznawanie mówcy
        )
        
        self.voice_notes[voice_id] = voice_note
        
        # Tworzy też tekstową notatkę z transkrypcją
        text_id = self.create_note(
            content=f"[VOICE] {transcript}",
            folder=folder,
            note_type=NoteType.VOICE,
            tags=['voice', 'audio', emotion] if emotion else ['voice', 'audio']
        )
        
        # Linkuj
        self.notes[text_id].metadata['voice_id'] = voice_id
        voice_note.metadata['text_id'] = text_id
        
        self.stats['voice_notes'] += 1
        
        return voice_id
    
    def _detect_emotion(self, text: str) -> Optional[str]:
        """Wykrywa emocję w tekście (uproszczone)"""
        text_lower = text.lower()
        
        emotions = {
            'excited': ['ekscyt', 'wow', 'super', 'niesamowit'],
            'urgent': ['piln', 'szybko', 'natychmiast', 'ważn'],
            'happy': ['szczęśliw', 'radoś', 'świetn', 'dobrz'],
            'thoughtful': ['myślę', 'zastanawiam', 'pytani', 'ciekaw']
        }
        
        for emotion, keywords in emotions.items():
            if any(keyword in text_lower for keyword in keywords):
                return emotion
        
        return None
    
    # ==================== PRZYPOMNIENIA KONTEKSTOWE ====================
    
    def set_reminder(self,
                    note_id: str,
                    trigger_type: str,
                    trigger_value: str,
                    message: str) -> str:
        """Ustawia kontekstowe przypomnienie"""
        
        if note_id not in self.notes:
            return "error: note not found"
        
        reminder_id = f"r{int(time.time())}{len(self.reminders):04d}"
        
        reminder = Reminder(
            id=reminder_id,
            note_id=note_id,
            trigger_type=trigger_type,
            trigger_value=trigger_value,
            message=message,
            created=time.time()
        )
        
        self.reminders[reminder_id] = reminder
        self.stats['reminders_set'] += 1
        
        return reminder_id
    
    def check_reminders(self, context: Dict) -> List[Dict]:
        """Sprawdza przypomnienia dla danego kontekstu"""
        triggered = []
        
        for reminder_id, reminder in self.reminders.items():
            if reminder.triggered:
                continue
            
            if self._check_trigger(reminder, context):
                reminder.triggered = True
                
                # Pobierz notatkę
                note = self.get_note(reminder.note_id, full=False)
                
                triggered.append({
                    'reminder_id': reminder_id,
                    'message': reminder.message,
                    'note_preview': note.get('c', '') if note else '',
                    'triggered_at': time.time()
                })
        
        return triggered
    
    def _check_trigger(self, reminder: Reminder, context: Dict) -> bool:
        """Sprawdza czy trigger został aktywowany"""
        trigger_type = reminder.trigger_type
        trigger_value = reminder.trigger_value
        
        if trigger_type == 'time':
            # Sprawdź czas
            current_time = datetime.now().strftime('%H:%M')
            return current_time == trigger_value
        
        elif trigger_type == 'location':
            # Sprawdź lokalizację
            current_location = context.get('location', '')
            return trigger_value in current_location
        
        elif trigger_type == 'state':
            # Sprawdź stan
            current_state = context.get('state', '')
            return trigger_value == current_state
        
        elif trigger_type == 'context':
            # Sprawdź kontekst (np. po zakończeniu zadania)
            current_activity = context.get('activity', '')
            return trigger_value in current_activity
        
        return False
    
    # ==================== OPERACJE NA FOLDERACH ====================
    
    def get_folder_contents(self, folder: FolderType, limit: int = 20) -> Dict:
        """Pobiera zawartość folderu z optymalizacją"""
        note_ids = self.folders.get(folder, [])[:limit]
        
        # Użyj cache'u
        contents = []
        for note_id in note_ids:
            cache_key = f"note_{note_id}"
            cached = self.cache.get(cache_key)
            
            if cached:
                contents.append(cached)
            else:
                note = self.notes.get(note_id)
                if note:
                    note_dict = note.to_dict()
                    self.cache.set(cache_key, note_dict)
                    contents.append(note_dict)
        
        return {
            'folder': folder.value,
            'count': len(self.folders[folder]),
            'contents': contents,
            'retrieved': len(contents)
        }
    
    def search_notes(self, query: str, limit: int = 10) -> List[Dict]:
        """Wyszukuje notatki z optymalizacją"""
        results = []
        query_lower = query.lower()
        
        # Szukaj w cache'u najpierw
        for note_id, note in self.notes.items():
            if query_lower in note.content.lower() or any(query_lower in tag.lower() for tag in note.tags):
                cache_key = f"note_{note_id}"
                cached = self.cache.get(cache_key)
                
                if cached:
                    results.append(cached)
                else:
                    results.append(note.to_dict())
                
                if len(results) >= limit:
                    break
        
        return results
    
    # ==================== EKSPORT I IMPORT ====================
    
    def export_for_lovable(self, compress: bool = True) -> Dict:
        """Eksportuje dane w formacie dla Lovable"""
        
        # Zbierz podstawowe dane
        export_data = {
            'version': '2.0',
            'exported_at': time.time(),
            'stats': self.stats.copy(),
            'folders': {},
            'recent_notes': [],
            'pending_reminders': []
        }
        
        # Eksportuj foldery (tylko podsumowanie)
        for folder_type, note_ids in self.folders.items():
            if note_ids:
                folder_key = folder_type.value
                export_data['folders'][folder_key] = {
                    'count': len(note_ids),
                    'recent': note_ids[:3]  # Tylko 3 najnowsze
                }
        
        # Eksportuj ostatnie notatki (ograniczona ilość)
        recent_limit = 10
        recent_notes = sorted(self.notes.values(), 
                            key=lambda x: x.modified, 
                            reverse=True)[:recent_limit]
        
        for note in recent_notes:
            export_data['recent_notes'].append(note.to_dict())
        
        # Eksportuj nieaktywowane przypomnienia
        for reminder in self.reminders.values():
            if not reminder.triggered:
                export_data['pending_reminders'].append(reminder.to_dict())
        
        # Cache stats
        export_data['cache_stats'] = self.cache.get_stats()
        
        # Optymalizacja dla API
        if compress:
            export_data = TokenOptimizer.optimize_for_api(export_data)
        
        self.stats['api_calls'] += 1
        
        return export_data
    
    def import_from_lovable(self, data: Dict) -> bool:
        """Importuje dane z Lovable"""
        try:
            # Wersja 2.0 - tylko podstawowe dane
            if data.get('version') == '2.0':
                # Można dodać logikę importu
                pass
            
            return True
        except Exception as e:
            print(f"Import error: {e}")
            return False
    
    # ==================== INTEGRACJA Z KAISKETCHBOARD ====================
    
    def integrate_with_sketchboard(self, sketch_data: Dict) -> str:
        """Integruje z KaiSketchBoard"""
        
        # Ekstrahuj dane ze szkicu
        content = sketch_data.get('content', '')
        style = sketch_data.get('style', 'buzzgrow')
        author = sketch_data.get('author', 'Ania')
        
        # Określ folder na podstawie stylu
        folder_map = {
            'buzzgrow': FolderType.EXPERIMENTS,
            'skicpig': FolderType.PROJECTS,
            'clean_minimal': FolderType.MODULES,
            'glitch_art': FolderType.EXPERIMENTS,
            'techno_soul': FolderType.PROJECTS
        }
        
        folder = folder_map.get(style, FolderType.EXPERIMENTS)
        
        # Twórz notatkę
        note_id = self.create_note(
            content=f"[SKETCH: {style}] {content}",
            folder=folder,
            note_type=NoteType.SKETCH,
            tags=['sketchboard', style, author]
        )
        
        # Dodaj metadane szkicu
        self.notes[note_id].metadata.update({
            'sketch_style': style,
            'sketch_author': author,
            'sketch_data': sketch_data.get('visual_data', {})
        })
        
        return note_id
    
    # ==================== STATYSTYKI I RAPORTY ====================
    
    def get_system_stats(self) -> Dict:
        """Zwraca statystyki systemu"""
        
        # Oblicz token efficiency
        total_content_length = sum(len(n.content) for n in self.notes.values())
        voice_content_length = sum(len(v.transcript) for v in self.voice_notes.values())
        total_length = total_content_length + voice_content_length
        
        # Przybliżona liczba tokenów (1 token ≈ 4 znaki)
        estimated_tokens = total_length // 4
        
        return {
            'total_notes': len(self.notes),
            'voice_notes': len(self.voice_notes),
            'reminders': len(self.reminders),
            'total_folders': len(self.folders),
            'estimated_tokens': estimated_tokens,
            'tokens_saved': self.stats['tokens_saved'],
            'cache_efficiency': self.cache.get_stats()['hit_rate'],
            'api_calls': self.stats['api_calls'],
            'token_efficiency': self._calculate_token_efficiency()
        }
    
    def _calculate_token_efficiency(self) -> float:
        """Oblicza efektywność użycia tokenów"""
        total_notes = len(self.notes) + len(self.voice_notes)
        if total_notes == 0:
            return 1.0
        
        # Im więcej notatek na token, tym lepiej
        total_content = sum(len(n.content) for n in self.notes.values()) + \
                       sum(len(v.transcript) for v in self.voice_notes.values())
        
        tokens = total_content // 4
        if tokens == 0:
            return 100.0
        
        return total_notes / tokens * 100  # Notatki na 100 tokenów

