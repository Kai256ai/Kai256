# ==================== FAST API ENDPOINTS (PRZYKŁAD) ====================

class KaiBoardAPI:
    """Przykładowe endpointy API dla Lovable"""
    
    def __init__(self):
        self.board = KaiBoardLovable()
    
    # Endpointy z optymalizacją tokenów
    
    def create_note_endpoint(self, data: Dict) -> Dict:
        """POST /api/board/notes"""
        try:
            note_id = self.board.create_note(
                content=data['content'],
                folder=FolderType(data['folder']),
                tags=data.get('tags', []),
                priority=Priority(data.get('priority', 2))
            )
            
            return {
                'success': True,
                'note_id': note_id,
                'tokens_saved': self.board.stats['tokens_saved']
            }
        except Exception as e:
            return {
                'success': False,
                'error': str(e)
            }
    
    def get_notes_endpoint(self, folder: str = None, limit: int = 20) -> Dict:
        """GET /api/board/notes"""
        try:
            if folder:
                folder_enum = FolderType(folder)
                notes = self.board.get_folder_contents(folder_enum, limit)
            else:
                # Zwróć wszystkie (ograniczone)
                all_notes = []
                for folder_type in FolderType:
                    folder_content = self.board.get_folder_contents(folder_type, limit // len(FolderType))
                    all_notes.extend(folder_content.get('contents', []))
                
                notes = {
                    'all_notes': all_notes[:limit],
                    'total_count': len(self.board.notes)
                }
            
            return {
                'success': True,
                'data': notes,
                'cache_hits': self.board.cache.hits
            }
        except Exception as e:
            return {
                'success': False,
                'error': str(e)
            }
    
    def set_reminder_endpoint(self, data: Dict) -> Dict:
        """POST /api/board/reminders"""
        try:
            reminder_id = self.board.set_reminder(
                note_id=data['note_id'],
                trigger_type=data['trigger_type'],
                trigger_value=data['trigger_value'],
                message=data['message']
            )
            
            return {
                'success': True,
                'reminder_id': reminder_id
            }
        except Exception as e:
            return {
                'success': False,
                'error': str(e)
            }
    
    def export_endpoint(self, compress: bool = True) -> Dict:
        """GET /api/board/export"""
        try:
            export_data = self.board.export_for_lovable(compress)
            
            return {
                'success': True,
                'data': export_data,
                'size_bytes': len(json.dumps(export_data))
            }
        except Exception as e:
            return {
                'success': False,
                'error': str(e)
            }

